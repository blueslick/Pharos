---
// "How to enter, step by step": the ONE how-to-enter content on the Register page (built only when
// REGISTRATION_OPEN is true; the page decides). Six steps in an ordered list, each one an outlined box.
// Everything an entrant needs is inside the steps: who can enter (1), the essay rules (2), the bank
// details (3, id="how-to-pay": the Tally form and the FAQ link to /register/#how-to-pay),
// the proof of payment (4), the entry form with the consent line and the Enter now button (5), and what
// happens next (6). Every value comes from src/site.ts. Plain HTML and CSS, no script. The step numbers are decoration
// (aria-hidden) because the list already numbers the items.
// Boxes: the same thin plum outline as the bank list (.bank), square corners like it, and the cream
// token for the fill (the lightest colour token: there is no white token).
// Layout: phone = one column, small boxes, the number beside the title, a short connector between boxes;
// tablet (640px) = 2 columns; desktop (1024px) = steps 1 and 2 side by side, step 3 (the long one) across
// the full row, then steps 4, 5 and 6.
import ExternalAction from './ExternalAction.astro';
import {
  SITE_NAME, REGISTRATION_URL, RULES_URL, FAQ_URL, ENTRY_FEE, ENTRY_FEE_SHORT, ENTRY_FEE_FULL, PAY_IN_MYR, CURRENCY_NOTE,
  PROOF_OF_PAYMENT_INLINE, SOUP_KITCHEN_NAME, BANK, CATEGORIES, DATES,
  formatDate, deadlineWithTime, isPlaceholder,
} from '../site';

const junior = CATEGORIES.find((c) => c.id === 'junior')!;
const open = CATEGORIES.find((c) => c.id === 'open')!;
---

<section class="hte" aria-labelledby="hte-title">
  <h2 id="hte-title" class="hte__title">How to enter, step by step</h2>
  <ol class="hte__list" role="list">
    <li class="hte__item hte__check">
      <div class="hte__head"><span class="hte__n" aria-hidden="true">1</span><h3 class="hte__step">Check you can enter</h3></div>
      <div class="hte__text">
        <p class="hte__line">
          Open to students only: Junior is {junior.who}, Open is {open.who} (your age on {formatDate(DATES.deadline)}).
        </p>
        {/* RULES_URL and FAQ_URL in src/site.ts are the Rules and FAQ pages. */}
        <p class="hte__links">
          {isPlaceholder(RULES_URL) ? <span><span class="pill">Placeholder</span> Rules: {RULES_URL}</span> : <a href={RULES_URL}>Read the full rules</a>}
          <a href={FAQ_URL}>Questions? Read the FAQ</a>
        </p>
      </div>
    </li>

    <li class="hte__item hte__write">
      <div class="hte__head"><span class="hte__n" aria-hidden="true">2</span><h3 class="hte__step">Write your essay</h3></div>
      <div class="hte__text">
        <p class="hte__line">
          One essay of up to 800 words on one of the three prompts, as a PDF, written by you (see the <a href="/faq/#ai-policy">AI policy</a>).
          Name your PDF with your full name and the essay title, for example “Jane Tan - Who Gets to Eat.pdf”.
          Do not put your name or school inside the essay.
        </p>
        <p class="hte__links"><a href="/competition/#prompts">See the prompts</a></p>
      </div>
    </li>

    {/* ONE money section: the fee is paid here. The entry form links to #how-to-pay. */}
    <li class="hte__item hte__pay" id="how-to-pay">
      <div class="hte__head"><span class="hte__n" aria-hidden="true">3</span><h3 class="hte__step">Pay {ENTRY_FEE_SHORT}</h3></div>
      <div class="hte__text">
        <div class="hte__pay-grid">
          <p class="hte__line">The fee is {ENTRY_FEE_FULL}, paid straight to {SOUP_KITCHEN_NAME}. {SITE_NAME} never handles the money.</p>
          <dl class="bank">
            <div><dt>Amount</dt><dd>{ENTRY_FEE}</dd></div>
            <div><dt>Currency</dt><dd>{BANK.currency}</dd></div>
            <div><dt>Account name</dt><dd>{BANK.accountName} ({BANK.accountNote})</dd></div>
            <div><dt>Bank</dt><dd>{BANK.bank}</dd></div>
            <div class="bank__copy"><dt>Account number</dt><dd><span class="bank__value bank__value--number">{BANK.accountNumber}</span></dd></div>
            <div class="bank__copy"><dt>SWIFT code</dt><dd><span class="bank__value">{BANK.swift}</span></dd></div>
            <div class="bank__copy"><dt>Reference</dt><dd><span class="bank__value">{BANK.reference}</span></dd></div>
          </dl>
          {/* The proof of payment is asked for once, in step 5, where it is uploaded. */}
          <p class="hte__line">{PAY_IN_MYR} {CURRENCY_NOTE} Any method may be used, provided the full {ENTRY_FEE} arrives. You pay any transfer fees.</p>
        </div>
      </div>
    </li>

    <li class="hte__item hte__shot">
      <div class="hte__head"><span class="hte__n" aria-hidden="true">4</span><h3 class="hte__step">Screenshot your payment</h3></div>
      <div class="hte__text">
        <p class="hte__line">
          Take a screenshot of the confirmation from your bank or app. You can crop out everything except the amount, date, recipient and transaction ID.
        </p>
      </div>
    </li>

    <li class="hte__item hte__enter">
      <div class="hte__head"><span class="hte__n" aria-hidden="true">5</span><h3 class="hte__step">Fill in the entry form</h3></div>
      <div class="hte__text">
        <p class="hte__line">Upload your essay, then {PROOF_OF_PAYMENT_INLINE}. Deadline: {deadlineWithTime()}.</p>
        {/* CONSENT: keep this line and the Privacy link right next to the Enter now button.
            Entrants may be under 18 and Malaysia's PDPA applies. */}
        <p class="hte__line hte__consent">The form asks for your consent to how we handle your details (and a parent or guardian's if you are under 18). See our <a href="/privacy/">Privacy notice</a>.</p>
        <ExternalAction href={REGISTRATION_URL} label="Enter now" tone="coral" />
      </div>
    </li>

    <li class="hte__item hte__confirm">
      <div class="hte__head"><span class="hte__n" aria-hidden="true">6</span><h3 class="hte__step">We confirm</h3></div>
      <div class="hte__text">
        <p class="hte__line">We check payments with {SOUP_KITCHEN_NAME} once a week and email you within a week of entering.</p>
      </div>
    </li>
  </ol>
</section>

<style>
  /* Phone sizes first; the media queries below make the boxes roomier. */
  .hte {
    --hte-gap: var(--space-1);
    --hte-pad-y: calc(var(--space-1) * 1.5);
    --hte-pad-x: var(--space-2);
    --hte-n: 28px;
    --hte-inner: calc(var(--space-1) / 2);
    display: flex; flex-direction: column; gap: var(--space-2);
  }
  .hte__title { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-heading-sm); line-height: 1.1; }

  .hte__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--hte-gap); }

  /* One outlined box per step: the same 1.5px plum line as the bank list, cream fill (lightest token). */
  .hte__item {
    position: relative;
    display: flex; flex-direction: column; gap: var(--hte-inner);
    padding: var(--hte-pad-y) var(--hte-pad-x);
    background: var(--c-cream);
    color: var(--c-plum);
    border: 1.5px solid var(--c-plum);
  }
  /* Phone: a short connector between one box and the next, under the number */
  .hte__item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--hte-pad-x) + var(--hte-n) / 2 - 1px);
    top: calc(100% + 1.5px);
    height: var(--hte-gap);
    width: 2px;
    background: var(--c-plum);
  }

  /* The number sits left of the title, on the same line. Coral is a fill: the number on it is plum-deep. */
  .hte__head { display: flex; align-items: center; gap: var(--space-1); }
  .hte__n {
    flex: none;
    display: flex; align-items: center; justify-content: center;
    width: var(--hte-n); height: var(--hte-n); border-radius: var(--radius-round);
    background: var(--c-coral); color: var(--c-plum-deep);
    font-family: var(--font-display); font-size: 16px; line-height: 1;
  }
  .hte__step { margin: 0; font-family: var(--font-sans); font-weight: 700; font-size: var(--fs-body-lg); line-height: 1.25; }
  .hte__text { min-width: 0; display: flex; flex-direction: column; gap: var(--hte-inner); }
  .hte__line { margin: 0; font-size: var(--fs-body); line-height: var(--lh-body); }
  .hte__links { margin: 0; display: flex; flex-wrap: wrap; column-gap: var(--space-3); row-gap: 0; font-size: var(--fs-body); line-height: var(--lh-body); }
  .hte a { font-weight: 600; overflow-wrap: anywhere; }
  .hte__links > a, .hte__links > span { display: inline-block; padding: 6px 0; }
  .hte :global(:focus-visible) { outline-color: var(--c-plum); }

  .hte__pay-grid { display: flex; flex-direction: column; gap: var(--hte-inner); }

  /* Bank details: account number and reference are big, selectable text (tap to select all of it) */
  .bank { margin: 0; display: flex; flex-direction: column; border-bottom: 1.5px solid var(--c-plum); }
  .bank > div { border-top: 1.5px solid var(--c-plum); padding: 10px 0; display: flex; flex-direction: column; gap: 2px; }
  .bank dt { font-size: var(--fs-body); font-weight: 600; }
  .bank dd { margin: 0; overflow-wrap: anywhere; font-size: var(--fs-body); line-height: var(--lh-body); }
  .bank__value { font-size: 24px; font-weight: 600; line-height: 1.25; user-select: all; -webkit-user-select: all; }
  .bank__value--number { white-space: nowrap; font-variant-numeric: tabular-nums; letter-spacing: 0.01em; }

  .hte__enter :global(.btn) { align-self: stretch; justify-content: center; min-height: 56px; font-size: var(--fs-heading-sm); font-family: var(--font-display); font-weight: 400; margin-top: var(--space-1); }
  .hte__enter :global(.placeholder-card) { margin-top: var(--space-1); }

  /* Phone only: label on the left, value on the right, so a detail takes one row instead of two.
     The account number and the reference are big text, so they keep their label above. */
  @media (max-width: 639px) {
    .bank { display: grid; grid-template-columns: max-content minmax(0, 1fr); column-gap: var(--space-2); }
    .bank > div { grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; align-items: baseline; padding: 6px 0; gap: 0 var(--space-2); }
    .bank > .bank__copy { display: flex; flex-direction: column; gap: 0; }
  }

  /* Tablet: 2 columns of boxes, no connector. The long step (3) and the last one take a full row. */
  @media (min-width: 640px) {
    .hte {
      --hte-gap: var(--space-2);
      --hte-pad-y: var(--space-3);
      --hte-pad-x: var(--space-3);
      --hte-n: 36px;
      --hte-inner: var(--space-1);
    }
    .hte__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; }
    .hte__item { gap: var(--space-1); align-content: start; }
    .hte__item:not(:last-child)::after { content: none; }
    .hte__n { font-size: 20px; }
    .hte__head { margin-bottom: 2px; }
    .hte__pay, .hte__confirm { grid-column: 1 / -1; }
    .hte__enter :global(.btn) { min-height: 72px; }
  }

  /* Desktop: a 6-column grid. Steps 1 and 2 are halves, step 3 is the full row (its bank details sit
     beside its text), steps 4, 5 and 6 are thirds. Boxes in a row are the same height. */
  @media (min-width: 1024px) {
    .hte { --hte-gap: var(--space-3); --hte-pad-y: var(--space-4); --hte-pad-x: var(--space-4); }
    .hte__list { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .hte__check, .hte__write { grid-column: span 3; }
    .hte__pay { grid-column: 1 / -1; }
    .hte__shot, .hte__enter, .hte__confirm { grid-column: span 2; }

    /* The bank list sits in the right column across all rows; the text stays together in the left one
       (the last, flexible row soaks up the extra height so the text rows don't stretch). */
    .hte__pay-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: auto auto 1fr; column-gap: var(--space-6); row-gap: var(--space-2); align-items: start; }
    .hte__pay-grid > .bank { grid-column: 2; grid-row: 1 / span 3; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-3); align-content: start; border-bottom: 0; }
    .hte__pay-grid > .bank > div { border-bottom: 0; }
    /* The last detail (the reference) takes the full row, so the list ends on one line. */
    .hte__pay-grid > .bank > div:last-child { grid-column: 1 / -1; border-bottom: 1.5px solid var(--c-plum); }
    .hte__pay-grid > :nth-child(1) { grid-column: 1; grid-row: 1; }
    .hte__pay-grid > :nth-child(3) { grid-column: 1; grid-row: 2; }
    .hte__enter .hte__consent { flex: 1; }
  }
</style>
