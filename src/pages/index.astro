---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EditionCover from '../components/EditionCover.astro';
import WaitlistAndFooter from '../components/WaitlistAndFooter.astro';
import SoupKitchenCard from '../components/SoupKitchenCard.astro';
import { SITE_NAME, SOUP_KITCHEN_NAME, SOUP_KITCHEN_INSTAGRAM_URL, FAQ_URL, DATES, CATEGORIES, formatDate } from '../site';

const junior = CATEGORIES.find((c) => c.id === 'junior')!;
const open = CATEGORIES.find((c) => c.id === 'open')!;
const intro = `${SITE_NAME} is an essay competition for students, with a Junior category (${junior.who}) and an Open category (${open.who}), built around the UN Sustainable Development Goals.`;
---

<Base description={intro}>
  <Hero padBottom={[130, 150]}>
    <h1 class="t-display-xl home-title">Big problems. Young writers. One goal at a time.</h1>
    <p slot="aside" class="t-lead">{intro}</p>
  </Hero>

  <main id="main">
    <div class="top-row">
      <section class="who">
        <span class="who__dot" aria-hidden="true"></span>
        <h2 class="t-heading">Who we are</h2>
        <p class="t-lead who__text">
          We are student volunteers who think young people should have a say on the world's biggest problems, and that
          writing about them can do real good. Each edition takes one goal, asks three questions, and is a
          fundraiser for {SOUP_KITCHEN_NAME}.
        </p>
        <a class="btn btn--plum" href="/about/">About us</a>
      </section>

      <section class="doings" aria-labelledby="doings-title">
        <h2 id="doings-title" class="t-heading">What we do</h2>
        <div class="doings__grid">
          <div class="doing doing--comp">
            <h3 class="t-heading-sm">The competition</h3>
            <p>One SDG per edition, judged by humans.</p>
            <a class="btn btn--coral" href="/competition/">See the competition</a>
          </div>
          <div class="doing doing--blog">
            <h3 class="t-heading-sm">The blog</h3>
            <p>Essays and explainers on the SDGs.</p>
            <a class="btn btn--plum" href="/blog/">Read the blog</a>
          </div>
          <div class="doing doing--volunteer">
            <h3 class="t-heading-sm">Volunteering</h3>
            <p>Volunteering with {SOUP_KITCHEN_NAME}.</p>
            <a class="btn btn--cream" href={SOUP_KITCHEN_INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
              Find out on Instagram<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </section>
    </div>

    <section class="edition" aria-labelledby="edition-title">
      <span class="rings edition__rings-a" aria-hidden="true"></span>
      <span class="rings edition__rings-b" aria-hidden="true"></span>
      <p class="t-label edition__label mobile-only">Inaugural edition: Goal 2, Zero Hunger</p>
      <div class="edition__cover"><EditionCover size={[308, 516]} /></div>
      <div class="edition__text">
        <p class="t-label edition__label desktop-only">Inaugural edition: Goal 2, Zero Hunger</p>
        <h2 id="edition-title" class="t-display">Your essay can feed someone.</h2>
        <p class="edition__line">This edition is a fundraiser for {SOUP_KITCHEN_NAME}. Opens {formatDate(DATES.entriesOpen)}.</p>
        <div class="edition__partner">
          <p class="t-label edition__partner-label">Inaugural Edition partner</p>
          <SoupKitchenCard />
        </div>
        <a class="btn btn--cream desktop-only" href="/competition/">See the competition</a>
        <p class="faq-link desktop-only">Questions? <a href={FAQ_URL}>Read the FAQ</a></p>
      </div>
    </section>

    <WaitlistAndFooter id="home-waitlist">
      <a class="btn btn--cream mobile-only" href="/competition/">See the competition</a>
      <p class="faq-link mobile-only">Questions? <a href={FAQ_URL}>Read the FAQ</a></p>
    </WaitlistAndFooter>
  </main>
</Base>

<style>
  .home-title { margin-top: 64px; max-width: 290px; }

  /* Top row: Who we are + What we do */
  .who {
    position: relative;
    padding: 44px var(--gutter) 48px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
  }
  .who > :not(.who__dot) { position: relative; }
  .who__dot {
    position: absolute;
    right: -70px; top: 30px;
    width: 140px; height: 140px;
    border-radius: 50%;
    background: var(--c-pink);
  }
  .who__text { max-width: none; }

  /* What we do */
  .doings { padding: 0 var(--gutter) 52px; display: flex; flex-direction: column; gap: 20px; }
  .doings__grid { display: flex; flex-direction: column; gap: 16px; }
  .doing { display: flex; flex-direction: column; gap: 8px; }
  .doing .btn { margin-top: 6px; }
  .doing--comp {
    margin-left: calc(-1 * var(--gutter));
    background: var(--c-plum);
    color: var(--c-cream);
    border-radius: 0 120px 120px 0;
    padding: 24px 90px 24px var(--gutter);
  }
  .doing--blog {
    margin-right: calc(-1 * var(--gutter));
    background: var(--c-pink);
    color: var(--c-plum-deep);
    border-radius: 120px 0 0 120px;
    padding: 24px var(--gutter) 24px 56px;
  }

  .doing--volunteer {
    background: var(--c-slate);
    color: var(--c-cream);
    border-radius: var(--radius-card);
    padding: 24px var(--gutter);
  }

  /* Current edition */
  .edition {
    position: relative;
    background: var(--c-plum);
    color: var(--c-cream);
    padding: 36px var(--gutter) 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    overflow: hidden;
  }
  .edition > :not(.rings) { position: relative; }
  .edition__rings-a { --ring: var(--c-peach); width: 260px; height: 260px; left: -130px; top: 200px; opacity: 0.7; }
  .edition__rings-b { --ring: var(--c-pink); width: 240px; height: 240px; right: -120px; top: 90px; opacity: 0.8; }
  .edition__label { align-self: stretch; color: var(--c-peach); }
  .edition__cover { display: flex; justify-content: center; width: 100%; }
  .edition__text { align-self: stretch; display: flex; flex-direction: column; gap: 10px; }
  .edition__line { font-size: 17px; line-height: 1.45; }
  .edition__partner { display: flex; flex-direction: column; gap: 10px; margin-top: 6px; }
  .edition__partner-label { color: var(--c-peach); }

  /* The small FAQ link under the call to action (a text link, not a button; padded to a 44px+ tap target) */
  .faq-link { font-size: 16px; line-height: 1.4; }
  .faq-link a { display: inline-block; padding: 12px 0; font-weight: 600; }

  @media (min-width: 960px) {
    .home-title { margin-top: 110px; max-width: 820px; }

    .top-row { margin-top: 72px; }
    .who {
      padding: 40px var(--gutter) 24px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      column-gap: 48px;
      row-gap: 18px;
      align-items: start;
      overflow: visible;
    }
    .who .t-heading { grid-column: 1; grid-row: 1 / span 2; }
    .who__text { grid-column: 2; max-width: 32em; }
    .who .btn { grid-column: 2; justify-self: start; }
    .who__dot { left: -130px; right: auto; top: -70px; width: 160px; height: 160px; }
    
    .doings { padding: 40px var(--gutter) 96px; gap: 28px; }
    .doings__grid { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 20px; align-items: stretch; }
    .doing { gap: 10px; font-size: 18px; }
    .doing .btn { margin-top: auto; }
    .doing p:last-of-type { margin-bottom: 12px; }
    .doing--comp { margin-left: 0; border-radius: 0 180px 180px 0; padding: 36px clamp(80px, 8.3vw, 120px) 36px 36px; }
    .doing--blog { margin-right: 0; border-radius: 180px 0 0 180px; padding: 36px 36px 36px clamp(80px, 7.6vw, 110px); }
    .doing--volunteer { padding: 36px; }
    .doing--volunteer p { font-size: 18px; }

    .edition { flex-direction: row; padding: 80px var(--gutter) 88px; gap: clamp(48px, 6.25vw, 90px); }
    .edition__rings-a { width: 420px; height: 420px; left: -200px; top: 260px; }
    .edition__rings-b { width: 360px; height: 360px; right: -150px; top: -150px; }
    .edition__cover { width: auto; margin-left: clamp(0px, 6.25vw, 90px); }
    .edition__text { align-self: center; max-width: 560px; gap: 18px; }
    .edition__line { font-size: 22px; }
    .edition__text .btn { margin-top: 8px; }
  }
</style>
