---
// Competition page, pre-launch state: the edition, the facts that are already
// fixed (dates, the two categories and their prizes, the fee, where the money
// goes), the three prompts, how essays are judged (the rubric), how it works, and
// the waitlist, with links to the Rules and FAQ pages. The "raised so far" counter stays out
// until launch (see the marked slots). The prompts and rubric show whether or not REGISTRATION_OPEN is true.
import { statSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import EditionCover from '../components/EditionCover.astro';
import WaitlistAndFooter from '../components/WaitlistAndFooter.astro';
import SoupKitchenCard from '../components/SoupKitchenCard.astro';
import {
  SITE_NAME, SOUP_KITCHEN_NAME, CONTACT_EMAIL, DATES, formatDate, formatDateDay, DEADLINE_TIME_UTC, deadlineWithTime, CATEGORIES, CURRENCY_NOTE,
  ENTRY_FEE_FULL, PROOF_OF_PAYMENT_INLINE, MEALS_PER_ENTRY, DEADLINE_TIME_SHORT, RULES_URL, FAQ_URL,
  PROMPTS, PROMPTS_INTRO, RUBRIC, RUBRIC_CLOSING, RUBRIC_TOTAL, JUDGING_PDF_URL, JUDGING_PDF_PAGES,
} from '../site';

const junior = CATEGORIES.find((c) => c.id === 'junior')!;
const open = CATEGORIES.find((c) => c.id === 'open')!;

const facts = [
  { label: `Deadline, ${DEADLINE_TIME_SHORT}`, value: formatDate(DATES.deadline) },
  { label: 'Who', value: 'Students, in two categories' },
  { label: 'Length', value: 'Up to 800 words' },
  { label: 'AI', value: 'No AI-written essays' },
];

// The Key dates timeline. Every date comes from DATES; judging has no fixed date, so it says "Late January".
const keyDates: { label: string; when: string; time?: string; note?: string }[] = [
  { label: 'Entries open', when: formatDateDay(DATES.entriesOpen) },
  { label: 'Deadline', when: formatDateDay(DATES.deadline), time: DEADLINE_TIME_UTC },
  { label: 'Judging', when: 'Late January' },
  { label: 'Results', when: formatDateDay(DATES.results), note: 'On pharosprize.org and Instagram. Winners are also emailed.' },
];

// One sentence for the judging section, built from RUBRIC so the names and marks cannot drift:
// "Every essay is marked out of 100 against four criteria: response to the prompt (30), ..., and voice and originality (20)."
const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const criteria = RUBRIC.map((c) => `${c.name.charAt(0).toLowerCase()}${c.name.slice(1)} (${c.marks})`);
const rubricSentence = `Every essay is marked out of ${RUBRIC_TOTAL} against ${NUMBER_WORDS[RUBRIC.length]} criteria: ${criteria.slice(0, -1).join(', ')}, and ${criteria[criteria.length - 1]}.`;

// The criteria PDF lives in public/ (a test checks it is there). Its size is read at build time.
const pdfKb = Math.round(statSync(`public${JUDGING_PDF_URL}`).size / 1024);
const pdfMeta = `PDF, ${JUDGING_PDF_PAGES} ${JUDGING_PDF_PAGES === 1 ? 'page' : 'pages'}, ${pdfKb} KB`;

const steps = [
  { title: 'Enter', text: 'Check that you are eligible, then register.' },
  { title: 'Write', text: `Up to 800 words on one prompt. Submit by ${deadlineWithTime()}.` },
  { title: 'Read and scored by people', text: 'Every essay is read by a person. AI never judges.' },
  { title: 'Results', text: `Winners announced by ${formatDate(DATES.results)}.` },
];
---

<Base
  title="Competition"
  description={`The inaugural ${SITE_NAME} essay competition: Goal 2, Zero Hunger. For students, in two categories: Junior (${junior.who}) and Open (${open.who}). Opens ${formatDate(DATES.entriesOpen)}.`}
>
  <header class="top">
    <div class="top__slab">
      <span class="rings top__rings" aria-hidden="true"></span>
      <div class="top__bar">
        <a class="top__wordmark" href="/" aria-label={`${SITE_NAME}, home`}>{SITE_NAME}</a>
        <Nav current="/competition/" place="inline" />
      </div>
      <div class="top__edition">
        <div class="top__text">
          <p class="t-label top__label">Inaugural edition: Goal 2</p>
          <h1 class="top__title">Zero Hunger</h1>
          <p class="top__sdg desktop-only">This edition is based on Sustainable Development Goal 2 (SDG 2): Zero Hunger. The SDGs are 17 shared global goals for 2030; Goal 2 is to end hunger. <a class="top__sdg-link" href="/about/#sdgs">What are the SDGs?</a></p>
          <p class="top__opens">Opens {formatDate(DATES.entriesOpen)}</p>
        </div>
        <EditionCover size={[140, 456]} frame={[3, 8]} />
      </div>
      <p class="top__sdg mobile-only">This edition is based on Sustainable Development Goal 2 (SDG 2): Zero Hunger. The SDGs are 17 shared global goals for 2030; Goal 2 is to end hunger. <a class="top__sdg-link" href="/about/#sdgs">What are the SDGs?</a></p>
    </div>

    {/* PARTNER: the soup kitchen's logo, name and socials (SoupKitchenCard). When its
        announcement is ready, add an endorsement and a link to their post about it. */}
    <div class="partner">
      <SoupKitchenCard />
      <p class="partner__note">Entry fees are paid directly to {SOUP_KITCHEN_NAME} by bank transfer.</p>
    </div>
  </header>

  <main id="main">
    <section class="facts" aria-label="Key details">
      <dl class="facts__grid">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="dates" id="dates" aria-labelledby="dates-title">
      <h2 id="dates-title" class="t-heading">Key dates</h2>
      <ol class="dates__list">
        {keyDates.map((d) => (
          <li class="stop">
            <h3 class="stop__label">{d.label}</h3>
            <p class="stop__when">{d.when}{d.time && <span class="stop__time">, {d.time}</span>}</p>
            {d.note && <p class="stop__note">{d.note}</p>}
          </li>
        ))}
      </ol>
    </section>

    <section class="cats" aria-labelledby="cats-title">
      <h2 id="cats-title" class="t-heading">Two categories</h2>
      <ul class="cats__list">
        {CATEGORIES.map((c) => (
          <li class={`cat cat--${c.id}`}>
            <h3 class="cat__name">{c.name}</h3>
            <p class="cat__who">{c.who}</p>
            <p class="cat__prize"><span class="cat__prize-label">Prize</span> {c.prize}{' '}<span class="cat__guide">{c.usdGuide}</span></p>
          </li>
        ))}
      </ul>
      <p class="cats__note">
        Age is counted as at {formatDate(DATES.deadline)}. Both categories are for students only.
      </p>
    </section>

    <section class="prompts" id="prompts" aria-labelledby="prompts-title">
      <div class="prompts__head">
        <h2 id="prompts-title" class="t-heading">The prompts</h2>
        <p class="prompts__note">{PROMPTS_INTRO}</p>
      </div>
      <ol class="prompts__list">
        {PROMPTS.map((p) => (
          <li class={`prompt prompt--${p.n}`}>
            <span class="prompt__n" aria-hidden="true">{p.n}</span>
            <div class="prompt__body">
              {p.quote && (
                <blockquote class="prompt__quote">
                  <p>“{p.quote}”</p>
                  <footer>
                    <span aria-hidden="true">— </span><cite>{p.attribution}</cite>
                  </footer>
                </blockquote>
              )}
              <p class="prompt__text">{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="steps" aria-labelledby="steps-title">
      <h2 id="steps-title" class="t-heading">How it works</h2>
      <ol class="steps__list">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step__n" aria-hidden="true">{i + 1}</span>
            <div class="step__body">
              <h3 class="step__title">{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="judging" id="judging" aria-labelledby="judging-title">
      <h2 id="judging-title" class="t-heading">How essays are judged</h2>
      <p class="judging__intro">{rubricSentence}</p>
      <p class="judging__closing">{RUBRIC_CLOSING}</p>
      <div class="judging__download">
        <a class="btn btn--plum" href={JUDGING_PDF_URL} download>Download the judging criteria (PDF)</a>
        <span class="judging__meta">({pdfMeta})</span>
      </div>
    </section>

    <section class="money" aria-labelledby="money-title">
      <h2 id="money-title" class="t-heading">Where the money goes</h2>
      <p class="t-body-lg">{MEALS_PER_ENTRY}</p>
      <p class="t-body-lg">
        Entry fee: {ENTRY_FEE_FULL}. You pay {SOUP_KITCHEN_NAME} directly by bank transfer, and {PROOF_OF_PAYMENT_INLINE}.{' '}
        {SITE_NAME} never handles the money.
      </p>
      <p class="money__note">{CURRENCY_NOTE}</p>
      {/* MONEY SLOT (launch): "Raised so far" (no target) and "Donate without entering" go here. */}
    </section>

    <section class="rules" aria-labelledby="rules-title">
      <h2 id="rules-title" class="t-heading">Rules and FAQ</h2>
      <div class="rules__body">
        <p class="t-body-lg">The rules, and answers to the most frequently asked questions.</p>
        <p class="rules__links">
          <a class="btn btn--plum" href={RULES_URL}>Read the rules</a>
          <a class="btn btn--plum" href={FAQ_URL}>FAQ</a>
        </p>
        <p class="t-body-lg">Still have a question? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
      </div>
    </section>

    {/* ENTER SLOT (launch): "Entries are open", deadline and the Enter button
        replace the waitlist. */}
    <WaitlistAndFooter id="competition-waitlist" />
  </main>
</Base>

<style>
  /* Top: edition header inside the slab */
  .top__slab {
    position: relative;
    margin-right: var(--gutter);
    background: var(--c-plum);
    color: var(--c-cream);
    border-radius: 0 0 150px 0;
    padding: 6px var(--gutter) 26px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .top__slab > :not(.rings) { position: relative; }
  .top__rings { --ring: var(--c-pink); width: 240px; height: 240px; right: -130px; bottom: -130px; }
  .top__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; column-gap: 16px; }
  .top__wordmark {
    font-family: var(--font-script);
    font-size: var(--fs-wordmark);
    line-height: var(--lh-wordmark);
    color: var(--c-peach);
    text-decoration: none;
    padding: 8px 0;
  }
  .top__edition {
    margin-top: 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
  }
  .top__text { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .top__label { color: var(--c-peach); text-wrap: balance; }
  .top__title { font-family: var(--font-display); font-weight: 400; font-size: 48px; line-height: 0.96; }
  .top__opens { margin-top: 4px; font-size: 16px; font-weight: 600; }
  .top__sdg { margin-top: 14px; max-width: 260px; font-size: 16px; line-height: 1.4; }
  .top__text .top__sdg { margin-top: 0; }

  .partner {
    margin: 14px 30px 0 0;
    background: var(--c-slate);
    color: var(--c-cream);
    border-radius: 0 80px 80px 0;
    padding: 22px 30px 18px var(--gutter);
    font-size: 16px;
    line-height: 1.4;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .partner__note { font-size: 16px; line-height: 1.4; }

  /* Key facts */
  .facts { padding: 16px var(--gutter) 0; }
  .facts__grid { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 18px; border-bottom: 1.5px solid var(--c-plum); }
  .fact { border-top: 1.5px solid var(--c-plum); padding: 12px 0 16px; display: flex; flex-direction: column; gap: 4px; }
  .fact dt { font-size: 18px; font-weight: 600; }
  .fact dd { margin: 0; font-family: var(--font-display); font-size: 32px; line-height: 1.05; }

  /* Key dates: a vertical line down the left on phones, a horizontal line with four dots from 960px. */
  .dates { padding: 40px var(--gutter) 0; display: flex; flex-direction: column; gap: 16px; scroll-margin-top: 16px; }
  .dates__list { list-style: none; padding: 0; margin: 0; }
  .stop { position: relative; padding: 0 0 28px 36px; display: flex; flex-direction: column; gap: 4px; }
  .stop:last-child { padding-bottom: 0; }
  .stop::before { content: ''; position: absolute; left: 7px; top: 12px; bottom: -12px; width: 2px; background: var(--c-plum); }
  .stop:last-child::before { display: none; }
  .stop::after { content: ''; position: absolute; left: 0; top: 4px; width: 16px; height: 16px; box-sizing: border-box; border-radius: 50%; background: var(--c-coral); border: 2px solid var(--c-plum); }
  .stop__label { font-size: 18px; font-weight: 600; line-height: 1.3; }
  .stop__when { font-family: var(--font-display); font-size: 26px; line-height: 1.1; overflow-wrap: anywhere; }
  .stop__time { font-family: var(--font-sans); font-size: 18px; font-weight: 600; }
  .stop__note { font-size: 16px; line-height: 1.4; margin-top: 4px; }

  /* Categories */
  .cats { padding: 40px var(--gutter) 0; display: flex; flex-direction: column; gap: 16px; }
  .cats__list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .cat { background: var(--c-plum); color: var(--c-cream); border-radius: 0 var(--radius-card) var(--radius-card) var(--radius-card); padding: 22px 24px; display: flex; flex-direction: column; gap: 6px; }
  .cat__name { font-family: var(--font-display); font-weight: 400; font-size: 36px; line-height: 1; }
  .cat__who { font-size: 18px; font-weight: 600; }
  .cat__prize { font-family: var(--font-display); font-size: 32px; line-height: 1.1; margin-top: 6px; }
  .cat__guide { display: block; font-family: var(--font-sans); font-size: 16px; font-weight: 400; line-height: 1.3; margin-top: 4px; }
  .cat__prize-label { font-family: var(--font-sans); font-size: 16px; font-weight: 600; margin-right: 6px; }
  .cats__note { font-size: 17px; line-height: 1.45; }

  /* Where the money goes */
  .money { padding: 48px var(--gutter) 8px; display: flex; flex-direction: column; gap: 12px; max-width: 760px; }
  .money__note { font-size: 16px; line-height: 1.5; max-width: 60ch; }

  /* Prompts */
  .prompts { padding: 52px var(--gutter) 48px; display: flex; flex-direction: column; gap: 16px; }
  .prompts__head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 4px; }
  .prompts__note { font-size: 17px; }
  .prompts__list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .prompt {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 24px 56px 26px var(--gutter);
    margin-left: calc(-1 * var(--gutter));
    border-radius: 0 80px 80px 0;
  }
  .prompt__n { font-family: var(--font-display); font-size: 44px; line-height: 0.9; }
  .prompt__body { display: flex; flex-direction: column; gap: 12px; }
  .prompt__text { font-size: 19px; line-height: 1.4; font-weight: 600; text-wrap: pretty; }
  .prompt__quote { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .prompt__quote p { font-family: var(--font-display); font-size: 24px; line-height: 1.2; }
  .prompt__quote footer { font-size: 17px; font-weight: 600; }
  .prompt__quote cite { font-style: normal; }
  .prompt--1 { background: var(--c-plum); color: var(--c-cream); }
  .prompt--1 .prompt__n { color: var(--c-coral); }
  .prompt--2 {
    background: var(--c-pink);
    color: var(--c-plum-deep);
    margin: 0 calc(-1 * var(--gutter)) 0 0;
    border-radius: 80px 0 0 80px;
    padding: 24px var(--gutter) 26px 56px;
  }
  .prompt--3 { background: var(--c-slate); color: var(--c-cream); }
  .prompt--3 .prompt__n { color: var(--c-peach); }

  /* How it works */
  .steps { padding: 8px var(--gutter) 52px; display: flex; flex-direction: column; gap: 18px; }
  .steps__list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .step { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 16px; }
  .step__n { font-family: var(--font-display); font-size: 48px; line-height: 0.9; }
  .step__body { display: flex; flex-direction: column; gap: 4px; padding-bottom: 10px; border-bottom: 1.5px solid var(--c-plum); font-size: 16px; line-height: 1.45; }
  .step:last-child .step__body { border-bottom: 0; }
  .step__title { font-size: 18px; font-weight: 600; }

  /* How essays are judged: one sentence and a download button on a cream card (facts mode). */
  .judging {
    margin: 0 var(--gutter) 52px;
    background: var(--c-cream);
    color: var(--c-plum);
    border-radius: var(--radius-round) var(--radius-round) 28px 28px;
    padding: 60px 22px 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    scroll-margin-top: 16px;
  }
  .judging__intro, .judging__closing { font-size: 17px; line-height: 1.45; max-width: 760px; }
  .judging__download { display: flex; flex-wrap: wrap; align-items: center; column-gap: 14px; row-gap: 6px; margin-top: 4px; }
  .judging__download .btn { white-space: normal; padding-top: 10px; padding-bottom: 10px; }
  .judging__meta { font-size: 16px; line-height: 1.4; color: var(--c-plum-muted); }

  /* Rules */
  .rules { padding: 0 var(--gutter) 24px; display: flex; flex-direction: column; gap: 14px; }
  .rules__body { display: flex; flex-direction: column; gap: 14px; }
  .rules__links { display: flex; flex-wrap: wrap; gap: 12px; }
  .rules__links .btn { white-space: normal; padding-top: 10px; padding-bottom: 10px; }
  .rules a { font-weight: 600; overflow-wrap: anywhere; }

  @media (min-width: 960px) {
    .top__slab {
      margin-right: clamp(60px, 7.6vw, 110px);
      border-radius: 0 0 clamp(220px, 25vw, 360px) 0;
      padding: 24px var(--gutter) 80px;
    }
    .top__rings { --ring: var(--c-pink); width: 480px; height: 480px; right: auto; left: -260px; bottom: -320px; opacity: 0.7; }
    .top__bar { padding-right: clamp(60px, 9.7vw, 140px); }
    .top__edition {
      margin-top: 40px;
      gap: clamp(32px, 4.4vw, 64px);
      padding-right: clamp(60px, 10.4vw, 150px);
    }
    .top__text { gap: 22px; }
    .top__label { font-size: 22px; }
    .top__title { font-size: clamp(88px, 9.44vw, 136px); line-height: 0.92; }
    .top__sdg { margin-top: 0; max-width: 540px; font-size: 22px; }
    .top__opens { margin-top: 8px; font-size: 22px; }

    .partner {
      margin: 28px clamp(120px, 18vw, 260px) 0 var(--gutter);
      border-radius: var(--radius-round);
      padding: 30px 44px;
      font-size: 20px;
      gap: 10px;
    }
    .partner__note { font-size: 20px; }

    .facts { padding: 72px var(--gutter) 40px; }
    .facts__grid { column-gap: 48px; border-bottom: 0; }
    .fact { border-top-width: 2px; padding: 22px 0 36px; gap: 12px; }
    .fact:nth-last-child(-n + 2) { border-bottom: 2px solid var(--c-plum); }
    .fact dt { font-size: 20px; }
    .fact dd { font-size: clamp(44px, 4.17vw, 60px); line-height: 1; }

    .dates { padding: 0 var(--gutter) 16px; gap: 28px; }
    .dates__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .stop { padding: 36px 24px 0 0; gap: 8px; }
    .stop:last-child { padding-right: 0; }
    .stop::before { left: 16px; right: 0; top: 7px; bottom: auto; width: auto; height: 2px; }
    .stop::after { top: 0; }
    .stop__label { font-size: 20px; }
    .stop__when { font-size: 28px; }
    .stop__time { font-size: 18px; }

    .cats { padding: 24px var(--gutter) 40px; gap: 24px; }
    .cats__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: 900px; }
    .cat { padding: 32px 36px; gap: 8px; }
    .cat__name { font-size: 48px; }
    .cat__who { font-size: 22px; }
    .cat__prize { font-size: 48px; }
    .cats__note { font-size: 20px; max-width: 760px; }
    .money { padding: 0 var(--gutter) 96px; gap: 16px; }

    .prompts { padding: 80px var(--gutter) 96px; gap: 30px; }
    .prompts__head { flex-direction: row; align-items: baseline; gap: 20px; margin: 0; }
    .prompts__note { font-size: 20px; }
    .prompts__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
    .prompt,
    .prompt--2 {
      margin: 0;
      border-radius: 210px 210px 28px 28px;
      padding: 60px 36px 48px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
      text-align: center;
    }
    .prompt__n { font-size: 88px; }
    .prompt__body { gap: 16px; }
    .prompt__text { font-size: 21px; }
    .prompt__quote p { font-size: 28px; }
    .prompt__quote footer { font-size: 18px; }

    .steps { padding: 0 var(--gutter) 100px; gap: 36px; }
    .steps__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
    .step { display: flex; flex-direction: column; gap: 10px; border-top: 1.5px solid var(--c-plum); padding: 18px 16px 0 0; }
    .step__n { font-size: 80px; }
    .step__body { border: 0; padding: 0; gap: 10px; font-size: 18px; }
    .step__title { font-size: 21px; }

    .judging {
      margin: 0 clamp(120px, 15.3vw, 220px) 110px var(--gutter);
      border-radius: var(--radius-round);
      padding: 44px clamp(40px, 6vw, 88px);
      gap: 18px;
    }
    .judging__intro, .judging__closing { font-size: 20px; }

    .rules {
      padding: 0 var(--gutter) 40px;
      display: grid;
      grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
      gap: 64px;
      align-items: baseline;
    }
    .rules__body { max-width: 720px; }
  }
</style>
