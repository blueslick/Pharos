---
// Rules: ten numbered rules, one short page. Visible whether or not REGISTRATION_OPEN is true:
// it holds no bank details and no entry-form link. The wording is owner-approved, so copy it
// exactly. Values that live in src/site.ts (dates, fees, prizes, the soup kitchen's name, the
// contact email) are built from there so the rules can't drift from the rest of the site.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  SITE_NAME, CONTACT_EMAIL, FAQ_URL, JUDGING_PDF_URL, SOUP_KITCHEN_NAME, CATEGORIES, DATES,
  ENTRY_FEE, PRIZES_FULL, CURRENCY_NOTE, PROOF_OF_PAYMENT_INLINE, DEADLINE_TIME_PLAIN, WINNER_CHECK_DAYS, formatDate, formatDateDay, FAQ_URL_WINNER_AGE,
} from '../site';

const junior = CATEGORIES.find((c) => c.id === 'junior')!;
const open = CATEGORIES.find((c) => c.id === 'open')!;
// "pharosprize.org", from the `site` setting in astro.config.mjs
const domain = Astro.site!.host;

const intro = 'Ten rules. The FAQ explains the details.';
---

<Base title="Rules" description={`The rules of the ${SITE_NAME} essay competition: who can enter, the essay, the fee, the deadline and judging.`}>
  <Hero padBottom={[90, 130]}>
    <h1 class="t-display-xl rules-title">Rules</h1>
    <p slot="aside" class="t-lead">{intro}</p>
  </Hero>

  <main id="main" class="rules">
    <ol class="rules__list">
      <li>
        Students only, from any country. {junior.name} is {junior.who}; {open.name} is {open.who}. Your age is your age on {formatDate(DATES.deadline)}. Junior-eligible entrants may enter Open instead.
      </li>
      <li>One essay per person, answering one of the three prompts.</li>
      <li>Up to 800 words, in English, uploaded as a PDF. Do not put your name or school inside the essay.</li>
      <li>
        It must be your own work. Do not use AI to write, rewrite, expand or translate any of it (AI may be used only to find sources and brainstorm ideas; <a href="/faq/#ai-policy">see the FAQ</a>). Grammarly, QuillBot and similar tools are not allowed; the ordinary spelling and grammar check in Word or Google Docs is. Tell us on the entry form what you used AI for. Do not enter an essay that has been published or entered somewhere else.
      </li>
      <li>
        Pay the entry fee of {ENTRY_FEE} straight to {SOUP_KITCHEN_NAME} before you submit, and {PROOF_OF_PAYMENT_INLINE}.
      </li>
      <li>
        Under 18? A parent or guardian must agree to you entering. On the form, tick the box saying they agree and give their email address; we may email them to check.
      </li>
      <li>Submit by {formatDateDay(DATES.deadline)}, {DEADLINE_TIME_PLAIN}. No extensions.</li>
      <li>
        Essays are read and judged by people, against the published <a href={JUDGING_PDF_URL}>judging criteria</a>. The judges' decisions are final.
      </li>
      <li>
        Winners may be named on {domain} and Instagram by their pen name only (the pen name given on the entry form). Shortlisted entrants are not named publicly. Prizes: {PRIZES_FULL}; only the winner in each category receives prize money. Copyright in each essay remains with its writer. An essay is published only under its writer's pen name, and only with the separate written permission of its writer (and of a parent or guardian, if the writer is under 18).
      </li>
      <li>
        Before the prize is paid, the winner must confirm their age and that they are a student (see <a href={FAQ_URL_WINNER_AGE}>the FAQ</a>). If a winner cannot be reached, or does not complete this check, within {WINNER_CHECK_DAYS} days of the results email, they do not receive the prize and it goes to the next-ranked entry.
      </li>
    </ol>

    <p class="rules__after">{CURRENCY_NOTE}</p>
    <p class="rules__after">An entry that breaks these rules is disqualified.</p>
    <p class="rules__after">
      Questions? Read <a href={FAQ_URL}>the FAQ</a> or email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>

    <p class="rules__small">If a poster, listing or post says something different, these rules apply.</p>
    <p class="rules__small" data-rules-updated>
      Last updated {formatDate(DATES.rulesUpdated)}: fee support removed; the fee is paid as MYR 40; rule 10 has a 14-day time limit; rule 9 states copyright; Junior-eligible entrants may enter Open; entries that break the rules are disqualified; PDF file names use the full name and essay title; winners are named by pen name only and shortlisted entrants are not named; only winners receive prize money.
    </p>
  </main>

  <SiteFooter />
</Base>

<style>
  .rules-title { margin-top: 64px; }

  .rules {
    padding: 32px var(--gutter) 24px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    max-width: 760px;
  }
  .rules :global(:focus-visible) { outline-color: var(--c-plum); }
  .rules a { font-weight: 600; overflow-wrap: anywhere; }

  /* Real numbered list; the numbers use the display face through ::marker, so the list stays a list for screen readers. */
  .rules__list { padding-left: 2.1em; display: flex; flex-direction: column; gap: 12px; }
  .rules__list li { padding-left: 4px; text-wrap: pretty; }
  .rules__list li::marker { font-family: var(--font-display); font-size: 1.35em; }
  .rules__after { text-wrap: pretty; }
  .rules__after:first-of-type { margin-top: var(--space-1); font-weight: 600; }
  /* The page's regular text size (--fs-body, never under 16px), smaller than the rules above it. */
  .rules__small { font-size: var(--fs-body); line-height: var(--lh-body); text-wrap: pretty; }

  @media (min-width: 960px) {
    .rules-title { margin-top: 110px; }
    .rules { padding: 72px var(--gutter) 24px; gap: var(--space-3); }
    .rules__list { gap: 18px; }
  }
</style>
