---
// FAQ: every question is a native <details> (FaqItem.astro), closed by default, with a stable id
// so other pages can deep-link (e.g. /faq/#winner-age-check). Visible whether or not
// REGISTRATION_OPEN is true. Bank details never appear here: "How do I pay?" links to the
// How to enter page only once REGISTRATION_OPEN is true, and says when the details go up before that.
// The wording is owner-approved, so copy it exactly. Values that live in src/site.ts (dates, fees,
// the soup kitchen's name, the contact email, the rubric) are built from there so the
// answers can't drift from the rest of the site.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FaqItem from '../components/FaqItem.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  SITE_NAME, CONTACT_EMAIL, INSTAGRAM_HANDLE, CATEGORIES, RULES_URL, REGISTRATION_OPEN, SOUP_KITCHEN_NAME, BANK, DATES,
  ENTRY_FEE, ENTRY_FEE_MYR, PROOF_OF_PAYMENT, PROOF_OF_PAYMENT_INLINE, MEALS_ESTIMATE, PRIZES_NOTE, RUBRIC, DEADLINE_TIME, DEADLINE_TIME_PLAIN,
  PAYMENT_GRACE_DAYS_AFTER_DEADLINE, WINNER_CHECK_DAYS, ESSAY_REMOVAL_DAYS, formatDate, formatDateDay, addDays,
} from '../site';

const description = `Answers about entering the ${SITE_NAME} essay competition: who can enter, the essay, AI, paying, judging and your details.`;
const domain = Astro.site!.host; // "pharosprize.org", from the `site` setting in astro.config.mjs
const mailto = `mailto:${CONTACT_EMAIL}`;

const lowerFirst = (text: string) => `${text.charAt(0).toLowerCase()}${text.slice(1)}`;
// "response to the prompt (30), insight and understanding (30), clarity and structure (20) and voice and originality (20)"
const criteria = RUBRIC.map((c) => `${lowerFirst(c.name)} (${c.marks})`);
const criteriaList = `${criteria.slice(0, -1).join(', ')} and ${criteria[criteria.length - 1]}`;

const junior = CATEGORIES.find((c) => c.id === 'junior')!;
const open = CATEGORIES.find((c) => c.id === 'open')!;
// "14 and under" -> "14 or under", the way the answers say it
const orUnder = (who: string) => who.replace(' and under', ' or under');

const deadlineDate = formatDate(DATES.deadline);
const paymentFixDay = formatDateDay(addDays(DATES.deadline, PAYMENT_GRACE_DAYS_AFTER_DEADLINE));
---

<Base title="FAQ" description={description}>
  <Hero padBottom={[90, 130]}>
    <h1 class="t-display-xl faq-title">Questions</h1>
  </Hero>

  <main id="main" class="faq">
    <section class="faq-group" aria-labelledby="entering">
      <h2 id="entering" class="t-heading-sm">Entering</h2>
      <div class="faq-group__items">
        <FaqItem id="who-is-a-student" question="Who counts as a student?">
          <p>Anyone studying at a school, college or university on {deadlineDate}. We may ask for proof, such as a student card or a letter from your school, before we award a prize.</p>
        </FaqItem>
        <FaqItem id="which-category" question="Which category am I in?">
          <p>Your age on {deadlineDate}. If you are {orUnder(junior.who)}, you are {junior.name}. Otherwise, if you are {orUnder(open.who)}, you are {open.name}. If you are eligible for {junior.name}, you may choose to enter {open.name} instead. You may enter only one category, with one essay.</p>
        </FaqItem>
        <FaqItem id="poster-says-any-age" question="I saw a poster that says Open is for any age. Which is right?">
          <p>
            The Open category is for students aged {open.who} (as at {deadlineDate}). Some early posters and listings show an older version;{' '}
            <a href={RULES_URL}>the Rules page</a> is always the one that counts.
          </p>
        </FaqItem>
        <FaqItem id="enter-more-than-once" question="Can I enter more than once?">
          <p>No, one essay per person.</p>
        </FaqItem>
        <FaqItem id="under-18" question="I am under 18. What do I need?">
          <p>A parent or guardian must agree to you entering and to us handling your details. The entry form asks for a second email address; we suggest theirs.</p>
        </FaqItem>
        <FaqItem id="open-and-close" question="When do entries open and close?">
          <p>Entries open on {formatDateDay(DATES.entriesOpen)} and close on {formatDateDay(DATES.deadline)} at {DEADLINE_TIME}. Late entries are disqualified. <a href="/competition/#dates">See all key dates</a></p>
        </FaqItem>
        <FaqItem id="fix-a-mistake" question="I made a mistake in my entry. Can I fix it?">
          <p>
            Yes, until entries close ({deadlineDate}, {DEADLINE_TIME_PLAIN}). Email <a href={mailto}>{CONTACT_EMAIL}</a> with your full name,
            the email address you entered with, and what needs fixing. If it is your essay, attach the corrected PDF. After the deadline we cannot accept changes.
          </p>
        </FaqItem>
      </div>
    </section>

    <section class="faq-group" aria-labelledby="the-essay">
      <h2 id="the-essay" class="t-heading-sm">The essay</h2>
      <div class="faq-group__items">
        <FaqItem id="word-count" question="What counts towards the 800 words?">
          <p>Everything from the first word of your essay to the last, including footnotes. Your title and your reference list do not count. Essays over 800 words are disqualified.</p>
        </FaqItem>
        <FaqItem id="references" question="Do I need references?">
          <p>If you use someone else's words, ideas or numbers, credit them. Any clear, consistent style is acceptable.</p>
        </FaqItem>
        <FaqItem id="other-languages" question="Can I write in another language?">
          <p>No, essays must be in English.</p>
        </FaqItem>
        <FaqItem id="name-in-the-pdf" question="Why can I not put my name inside the essay?">
          <p>So that essays are judged without knowing who wrote them. The file name is removed before judging, and the form collects your name separately.</p>
        </FaqItem>
        <FaqItem id="make-a-pdf" question="How do I make a PDF?">
          <p>
            In Google Docs or Word, use File, then Download (or Save as), then PDF. Open the file before you submit to check it works. Name your PDF with your full name and the essay title,
            for example “Jane Tan - Who Gets to Eat.pdf”. Do not put your name or school inside the essay.
          </p>
        </FaqItem>
      </div>
    </section>

    <section class="faq-group" aria-labelledby="ai">
      <h2 id="ai" class="t-heading-sm">AI</h2>
      <div class="faq-group__items">
        <FaqItem id="ai-policy" question="What is the AI policy?">
          <p>You may use AI to find sources and to brainstorm ideas. You must read the sources yourself and write every word of your essay yourself.</p>
          <p>You may not use AI to write, rewrite, expand or translate any part of your essay. This includes Grammarly, QuillBot, and the AI writing features in Google Docs (Gemini) and Word (Copilot). The ordinary spelling and grammar check built into Word or Google Docs is permitted.</p>
          <p>The entry form asks what you used AI for. Answer in your own words, or write "Nothing". Using AI for sources or brainstorming will not count against you. We do not ask for your prompts.</p>
          <p>If the organisers believe your essay breaks this policy, it will be disqualified. We will not contact you about this decision. A detection tool's result is never the only reason.</p>
        </FaqItem>
      </div>
    </section>

    <section class="faq-group" aria-labelledby="paying">
      <h2 id="paying" class="t-heading-sm">Paying</h2>
      <div class="faq-group__items">
        <FaqItem id="where-the-fee-goes" question="Where does my fee go?">
          <p>Straight to {SOUP_KITCHEN_NAME}. {SITE_NAME} never handles the money. T.A.S.K tells us every {ENTRY_FEE} is {MEALS_ESTIMATE}.</p>
        </FaqItem>
        <FaqItem id="pay-how" question="How do I pay?">
          {/* Bank details are never on this page. Before launch the How to enter page has no details yet, so no link. */}
          <p>
            The fee is {ENTRY_FEE}, transferred as {ENTRY_FEE_MYR} to T.A.S.K's account by bank transfer.{' '}
            {
              REGISTRATION_OPEN ? (
                <>The details are on the <a href="/register/#how-to-pay">How to enter page</a>.</>
              ) : (
                <>The details go up on the How to enter page when entries open on {formatDate(DATES.entriesOpen)}.</>
              )
            }{' '}
            Use the reference "{BANK.reference}". {PROOF_OF_PAYMENT}
          </p>
        </FaqItem>
        <FaqItem id="pay-from-abroad" question="I am not in Malaysia. How do I pay?">
          <p>
            Use your bank's international transfer or a service such as Wise, Remitly or Western Union, and send {ENTRY_FEE_MYR} to T.A.S.K's account (SWIFT code {BANK.swift}).
            Transfer fees and bank charges are paid by you, not by {SITE_NAME}, and the full {ENTRY_FEE_MYR} must arrive. If less arrives, your entry is not complete.
          </p>
        </FaqItem>
        <FaqItem id="payment-arrived" question="How do I know my payment arrived?">
          <p>
            We check payments with T.A.S.K once a week and email you within a week of your entry. If we cannot find your payment, we will email you.
            You have until {paymentFixDay} to resolve it. If we still cannot find it by then, your entry is disqualified.
          </p>
        </FaqItem>
      </div>
    </section>

    <section class="faq-group" aria-labelledby="judging-and-results">
      <h2 id="judging-and-results" class="t-heading-sm">Judging and results</h2>
      <div class="faq-group__items">
        <FaqItem id="who-judges" question="Who judges the essays?">
          <p>
            The {SITE_NAME} organisers, against the published judging criteria: {criteriaList}. You can download the criteria from the{' '}
            <a href="/competition/#judging">Competition page</a>. AI is never used to score, rank or shortlist essays.
          </p>
        </FaqItem>
        <FaqItem id="feedback" question="Will I get feedback or a score?">
          <p>No. We cannot give individual scores or feedback.</p>
        </FaqItem>
        <FaqItem id="results" question="When are the results?">
          <p>{formatDateDay(DATES.results)}, on {domain} and Instagram ({INSTAGRAM_HANDLE}). Winners are also told by email.</p>
        </FaqItem>
        <FaqItem id="prizes-paid" question="How are prizes paid?">
          <p>
            By bank transfer or Wise to the winner, or to a parent or guardian if the winner is under 18, within 2 weeks of the results. {PRIZES_NOTE}{' '}
            If a winner cannot be reached, or does not complete the age and student check, within {WINNER_CHECK_DAYS} days of the results email, they do not receive the prize and it goes to the next-ranked entry.
          </p>
        </FaqItem>
        <FaqItem id="winner-age-check" question="How do winners confirm their age?">
          <p>
            Before we pay a prize, we check the winner's age and that they are a student. You can either show your ID on a short video call, or send a photo
            of it with the ID number partly covered (on a MyKad, cover the last six digits; the first six show your date of birth). A letter from your school
            is also accepted. If you are under 18, a parent or guardian joins the call or sends the photo. We do not keep a copy of your ID or its number; we only note
            that the check was done.
          </p>
        </FaqItem>
        <FaqItem id="certificate" question="Do I get a certificate?">
          <p>
            There are three e-certificates: a participation certificate for every eligible entrant, a shortlist certificate for shortlisted entrants, and a top-3 certificate for the top three
            essays in each category. All are emailed by {formatDate(DATES.certificatesBy)}. Each has a code that anyone can check at <a href="/verify/">{domain}/verify/</a>.
          </p>
        </FaqItem>
      </div>
    </section>

    <section class="faq-group" aria-labelledby="your-details">
      <h2 id="your-details" class="t-heading-sm">Your details and your essay</h2>
      <div class="faq-group__items">
        <FaqItem id="who-owns-my-essay" question="Who owns my essay?">
          <p>You do. Copyright remains with you. By entering, you allow {SITE_NAME} to store, read and judge your essay for this competition only.</p>
        </FaqItem>
        <FaqItem id="essay-published" question="Will my essay be published?">
          <p>
            Only with your permission. After the results, we may ask winners whether they would like their essay published on {domain}. If you are under 18, a parent or guardian must also agree.
            You may decline; this does not affect your result, prize or certificate. If you agree and later change your mind, email <a href={mailto}>{CONTACT_EMAIL}</a> and we will remove it
            within {ESSAY_REMOVAL_DAYS} days.
          </p>
        </FaqItem>
        <FaqItem id="what-we-publish" question="What do you publish about me?">
          <p>If you are shortlisted or win: your name only (no school, country or age), on {domain} and Instagram, as you agreed on the entry form.</p>
        </FaqItem>
        <FaqItem id="your-data" question="How do you handle my data?">
          <p>See our Privacy notice: <a href="/privacy/">{domain}/privacy/</a>.</p>
        </FaqItem>
        <FaqItem id="follow-or-tag" question={`Do I have to follow or tag ${SITE_NAME} to enter?`}>
          <p>No.</p>
        </FaqItem>
        <FaqItem id="who-runs-it" question={`Who runs ${SITE_NAME}?`}>
          <p>Student volunteers. This edition is a fundraiser for {SOUP_KITCHEN_NAME}.</p>
        </FaqItem>
      </div>
    </section>

    <p class="faq__stuck">Another question? Email <a href={mailto}>{CONTACT_EMAIL}</a>.</p>
  </main>

  <SiteFooter />
</Base>

<style>
  .faq-title { margin-top: 64px; }

  .faq {
    padding: 32px var(--gutter) 24px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
  }
  .faq :global(:focus-visible) { outline-color: var(--c-plum); }
  .faq a { font-weight: 600; overflow-wrap: anywhere; }

  .faq-group { display: flex; flex-direction: column; gap: var(--space-2); }
  .faq-group__items { display: flex; flex-direction: column; }
  .faq__stuck { font-weight: 600; }

  @media (min-width: 960px) {
    .faq-title { margin-top: 110px; }
    .faq { padding: 72px var(--gutter) 24px; gap: var(--space-6); }
    /* Group heading on the left, its questions on the right. */
    .faq-group { display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 760px); column-gap: var(--space-6); align-items: start; }
    .faq-group > h2 { padding-top: 10px; }
    .faq__stuck { padding-left: calc(320px + var(--space-6)); }
  }
</style>
